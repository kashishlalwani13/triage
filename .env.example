# Copy this file to .env and fill in your own Supabase values.
# Never commit .env (it is in .gitignore).

# Supabase > Connect > Direct > Session pooler. Replace [YOUR-PASSWORD] (no brackets).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys (anon / publishable key, never the secret key)
SUPABASE_ANON_KEY=your-anon-or-publishable-key
