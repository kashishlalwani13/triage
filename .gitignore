# Files git must never track or upload.

# Secrets: holds DATABASE_URL (Supabase address + password). Leaking it exposes the database.
.env

# Streamlit's secrets file: same risk as .env.
.streamlit/secrets.toml

# Virtual environment: large, Mac-specific, and rebuildable from requirements.txt.
.venv/

# Python's auto-generated bytecode cache: junk that changes constantly.
__pycache__/
*.pyc

# Test tool cache: auto-generated.
.pytest_cache/

# macOS folder settings: not part of the project and reveals details about the computer.
.DS_Store

# Personal editor settings: each developer's own preferences.
.vscode/

